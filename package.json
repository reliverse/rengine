{
    "name": "@reliverse/rengine-monorepo",
    "description": "Rengine is an open-source 2D and 3D game engine for building games, interactive tools, and content creation workflows.",
    "author": "Nazarii Korniienko <blefnk@gmail.com>",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "workspaces": {
        "catalog": {
            "@types/bun": "^1.3.11",
            "@typescript/native-preview": "^7.0.0-dev.20260409.1"
        },
        "packages": [
            "apps/*",
            "packages/*",
            "rese/apps/*",
            "rese/packages/*"
        ]
    },
    "scripts": {
        "typecheck": "bun -F='*' run typecheck",
        "build": "bun -F='*' run build",
        "clean": "./scripts/clean.sh",
        "fresh": "bun run clean && bun install",
        "rese:dev": "bun run --filter='@reliverse/rese' dev",
        "rese:dev:cli": "bun run --filter='@reliverse/rese' dev",
        "rese:dev:web": "bun run --filter='@repo/rese-web' dev",
        "rese:dev:wiki": "bun run --filter='@repo/rese-wiki' dev"
    },
    "packageManager": "bun@1.3.11",
    "engines": {
      "bun": ">=1.3.11"
    }
}